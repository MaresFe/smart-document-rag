# Self-hosted erisim ayarlari
APP_PORT=8080
PUBLIC_HOST=localhost
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=smart_rag
POSTGRES_PASSWORD=change_me_with_a_url_safe_password
POSTGRES_DB=smart_document_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smart_rag:change_me_with_a_url_safe_password@localhost:5432/smart_document_rag

# Uygulama guvenligi
APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true

# Belge ve OCR
MAX_UPLOAD_SIZE_MB=25
OCR_ENABLED=true
OCR_LANGUAGES=tur+eng
OCR_DPI=180
OCR_MAX_PAGES=25
OCR_PAGE_TIMEOUT_SECONDS=20
OCR_MIN_TEXT_CHARACTERS=10
OCR_MAX_PIXELS_PER_PAGE=20000000

# Embedding ve retrieval
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
RETRIEVAL_MIN_QUERY_CHARACTERS=2
RETRIEVAL_MIN_SIMILARITY_SCORE=0.75

# Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=120

# Kimlik dogrulama
AUTH_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_COOKIE_NAME=smart_rag_access_token
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_KEYS=10000
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=3
AUTH_PASSWORD_RESET_WINDOW_SECONDS=900
AUTH_TOKEN_MAX_ATTEMPTS=10
AUTH_TOKEN_WINDOW_SECONDS=300

# Hesap ve e-posta
REGISTRATION_MODE=invite_only
ACCOUNT_INVITATION_HOURS=24
ACCOUNT_PASSWORD_RESET_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@example.com
SMTP_TIMEOUT_SECONDS=15
